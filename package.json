{
  "name": "dsh-tool-drawer",
  "version": "0.1.0",
  "description": "Keep DeepSeek Harness's tool list small: the tools you use sit on the desk, everything else waits in a drawer and is fetched on demand.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "LICENSE",
    "locale"
  ],
  "scripts": {
    "test": "node --test tests/drawer.test.js tests/gate.test.js tests/smoke.test.js tests/docs.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "verifiedWith": "0.2.2-rc.3",
    "compatibility": {
      "dsh": ">=0.2.2-rc.3",
      "dshReleases": {
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "author": "zyd232",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyd232/dsh-tool-drawer.git"
  },
  "homepage": "https://github.com/zyd232/dsh-tool-drawer#readme",
  "bugs": {
    "url": "https://github.com/zyd232/dsh-tool-drawer/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "tool-drawer",
    "progressive-disclosure",
    "lazy-loading",
    "context-window",
    "tool-search"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
